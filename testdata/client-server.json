{
  "$schema": "https://shulker.sh/schema/v1/manifest.json",
  "name": "westcoast-smp",
  "version": "1.0",
  "minecraft": "~26.2",
  "loader": { "type": "fabric", "version": "^0.17" },
  "providers": ["modrinth", "curseforge"],

  "requires": {
    "base-pack": { "source": "https://github.com/shulker-sh/base-pack.git", "ref": "v3" },
    "fabric-api": {},
    "sodium": { "channel": "beta" },
    "iris": { "pin": "k9RhZq2X" },
    "lithium": {},
    "appleskin": { "side": "both" },
    "betterthirdperson": {
      "provider": "curseforge",
      "project": "355424",
      "side": "client"
    }
  },

  "ignore": [
    {
      "rule": "depends",
      "mod": "betterthirdperson",
      "on": "minecraft",
      "declared": "~26.1",
      "note": "Tested fine on 26.2 on 2026-09-08."
    }
  ],

  "variables": {
    "motd": "West Coast SMP",
    "discordInvite": "https://discord.gg/example"
  },

  "server": {
    "build": "build/server",
    "variables": { "motd": "West Coast SMP (dev build)" },
    "memory": "6G",
    "jvmFlags": "aikars",
    "properties": {
      "level-name": "westcoast",
      "motd": "${motd}",
      "difficulty": "hard",
      "view-distance": 12,
      "simulation-distance": 8,
      "white-list": true,
      "online-mode": true,
      "spawn-protection": 0
    },
    "players": {
      "whitelist": [
        { "name": "Notch" },
        { "uuid": "61699b2e-d327-4a01-9f1e-0ea8c3f06bc6" },
        { "name": "jeb_", "uuid": "853c80ef-3c37-49fd-aa49-938b674adae6" }
      ],
      "ops": [{ "name": "Notch", "level": 4 }],
      "bans": [
        { "name": "Griefer99", "reason": "Lava-casting spawn", "expires": "2026-12-31T00:00:00Z" }
      ]
    }
  },

  "client": {
    "build": "build/client",
    "options": {
      "renderDistance": 12,
      "guiScale": 3,
      "maxFps": 120,
      "fov": 0.5,
      "lang": "en_us"
    },
    "servers": [
      { "name": "West Coast SMP", "ip": "mc.westcoast.example:25565" },
      { "name": "Local test", "ip": "localhost", "note": "Points at build/server run via shulker serve" }
    ]
  }
}
