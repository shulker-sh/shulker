{
  "$schema": "https://shulker.sh/schema/v1/manifest.json",
  "name": "every-field",
  "version": "1.0",
  "description": "Sets every property the manifest schema allows.",
  "authors": ["Someone"],
  "license": "MIT",
  "icon": "assets/icon.png",
  "links": {
    "website": "https://example.com",
    "chat": "https://example.com/chat"
  },
  "note": "top",
  "minecraft": "26.2",
  "loader": { "type": "fabric", "version": "*", "note": "loader" },
  "java": ">=25",
  "providers": ["modrinth", "curseforge"],
  "history": 3,
  "features": {
    "fancy": {
      "default": true,
      "overrides": { "client": "fancy-client", "server": "fancy-server" },
      "note": "feature"
    },
    "shaders": { "overrides": "shader-overrides" }
  },
  "requires": {
    "base": { "type": "modpack", "source": "../base", "ref": "main", "path": "packs/base", "autoUpdate": false, "locked": false, "note": "modpack" },
    "extras": { "type": "resourcepack", "file": "packs/extras.zip", "filename": "Extras.zip" },
    "complementary": { "type": "shader", "project": "HVnmMxH1", "channel": "beta", "provider": "modrinth", "feature": "shaders" },
    "terralith": { "type": "datapack", "side": "server", "resourcepack": true },
    "sodium": {
      "project": "AANobbMI",
      "pin": "4TkX2p9Z",
      "channel": "beta",
      "side": "client",
      "provider": "modrinth",
      "os": "macos",
      "feature": ["fancy", "!shaders"],
      "note": "mod"
    },
    "jei": { "project": "238222", "pin": "5101366", "provider": "curseforge", "os": ["macos", "!linux"] }
  },
  "ignore": [
    { "rule": "depends", "mod": "sodium", "on": "minecraft", "declared": ">=26.3", "note": "works" }
  ],
  "wholeFiles": ["config/whole.properties"],
  "skipFiles": ["*.bak", "config/*.log"],
  "seedFiles": ["options.txt", "config/*.json5"],
  "marker": true,
  "integrations": { "iris": ["iris", "iris_fork"], "paxi": [] },
  "variables": { "motd": "Welcome", "port": 25565, "hardcore": false, "ratio": 1.50 },
  "server": {
    "name": "Every Field Server",
    "build": "build/server",
    "variables": { "motd": "Server" },
    "memory": "6G",
    "jvmFlags": "aikars",
    "jvmArgs": ["-XX:+UseZGC"],
    "properties": { "motd": "${motd}", "max-players": 20, "hardcore": false },
    "resourcePack": "extras",
    "players": {
      "whitelist": [{ "name": "Notch", "uuid": "069a79f4-44e9-4726-a5be-fca90e38aaf5", "note": "whitelist" }],
      "ops": [
        {
          "name": "Notch",
          "uuid": "069a79f4-44e9-4726-a5be-fca90e38aaf5",
          "note": "op",
          "level": 3,
          "bypassesPlayerLimit": true
        }
      ],
      "bans": [
        {
          "name": "Griefer",
          "uuid": "11111111-2222-3333-4444-555555555555",
          "note": "ban",
          "reason": "griefing",
          "expires": "2027-01-01T00:00:00Z"
        }
      ]
    },
    "note": "server"
  },
  "client": {
    "name": "Every Field",
    "build": "build/client",
    "variables": { "motd": "Client" },
    "hooks": { "preLaunch": true, "postExit": true },
    "memory": "6G",
    "options": { "fov": 0.5, "lang": "en_us", "autoJump": false },
    "resourcePacks": ["extras", "programmer_art"],
    "shader": "complementary",
    "servers": [{ "name": "Home", "ip": "example.com:25565", "note": "servers" }],
    "note": "client"
  }
}
